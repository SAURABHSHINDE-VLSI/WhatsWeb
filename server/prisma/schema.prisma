generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String              @id @default(cuid())
  username                String?             @unique
  displayName             String?
  email                   String?             // Private: for recovery & owner display only. Never exposed in API.
  avatarUrl               String?
  avatarTint              Int                 @default(0)
  usernameChangedAt       DateTime?
  privacyAllowMessages    String              @default("anyone") // "anyone" | "contacts_only"
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  identities              Identity[]
  sessions                Session[]
  wsTickets               WsTicket[]
  contacts                Contact[]           @relation("UserContacts")
  contactRequestsSent     ContactRequest[]    @relation("SentRequests")
  contactRequestsReceived ContactRequest[]    @relation("ReceivedRequests")
  blockedUsers            BlockedUser[]       @relation("UserBlocks")
  blockedBy               BlockedUser[]       @relation("BlockedByUsers")
  inviteLinks             InviteLink[]
  sentMessages            Message[]           @relation("SentMessages")
  receivedMessages        Message[]           @relation("ReceivedMessages")
  preKeyBundle            PreKeyBundle?
  pushSubscriptions       PushSubscription[]
  backup                  UserBackup?
  passkeys                PasskeyCredential[]
}

model Identity {
  id             String   @id @default(cuid())
  provider       String   // e.g. "google"
  providerUserId String   // Google stable 'sub' claim
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model UsernameReservation {
  id        String   @id @default(cuid())
  username  String   @unique
  heldUntil DateTime
  createdAt DateTime @default(now())

  @@index([heldUntil])
}

model AuthNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Session {
  id               String    @id @default(cuid())
  familyId         String    @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceName       String?
  ipAddress        String?
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model PreKeyBundle {
  id                    String          @id @default(cuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityKey           String          // base64 public X25519 DH key
  identitySignKey       String          // base64 public Ed25519 signing key
  signedPreKey          String          // base64 public signed pre-key
  signedPreKeySignature String          // base64 Ed25519 signature
  oneTimePreKeys        OneTimePreKey[]
  updatedAt             DateTime        @updatedAt
}

model OneTimePreKey {
  id          String        @id @default(cuid())
  bundleId    String
  bundle      PreKeyBundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  keyId       Int
  publicKey   String        // base64 public key
  consumed    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([bundleId, consumed])
}

model Message {
  id                String    @id @default(cuid())
  clientMessageId   String?   @unique
  senderId          String
  sender            User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId        String
  receiver          User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content           String    // Ciphertext blob (Base64) - ZERO plaintext on server!
  nonce             String    // 24-byte random nonce (Base64)
  ephemeralKey      String?   // Sender's ephemeral public key for X3DH / DH Ratchet
  recipientPreKeyId Int?      // One-time pre-key ID if consumed
  dhPublicKey       String?   // Current DH ratchet public key
  sequence          Int?      // Sequence number in ratchet chain
  envelope          String?   // Opaque versioned E2EE envelope JSON
  type              String    @default("text") // text | photo | voice
  mediaUrl          String?
  status            String    @default("sent") // sent | delivered | read
  replyToId         String?
  createdAt         DateTime  @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  expiresAt         DateTime? // Undelivered message expiry for disappearing messages

  @@index([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, receiverId, createdAt])
  @@index([status, deliveredAt, readAt, createdAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model Contact {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactId  String
  isPinned   Boolean  @default(false)
  isMuted    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, contactId])
}

model ContactRequest {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | accepted | ignored | rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model BlockedUser {
  id          String   @id @default(cuid())
  blockerId   String
  blocker     User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     User     @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserReport {
  id          String   @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      String
  createdAt   DateTime @default(now())

  @@index([reportedId])
}

model InviteLink {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model WsTicket {
  id        String   @id @default(cuid())
  ticket    String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticket])
  @@index([expiresAt])
  @@index([userId])
}

model UserBackup {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCiphertext String   // Base64 encrypted JSON blob (Zero server plaintext!)
  salt             String   // Base64 16-byte Argon2id salt
  nonce            String   // Base64 24-byte XChaCha20 nonce
  version          Int      @default(1)
  sizeBytes        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique // base64url or hex
  publicKey    String   // base64 public key
  counter      BigInt   @default(0)
  deviceName   String?
  transports   String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
}

